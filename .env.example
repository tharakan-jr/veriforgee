# Copy to .env. Never commit .env to version control.

# Core Review LLM Key (optional for voice-only testing)
LLM_API_KEY=

# ElevenLabs Voice Feature (Optional)
# Obtain your key from https://elevenlabs.io (Profile -> API Keys)
ELEVENLABS_API_KEY=

# Optional Voice Configuration (defaults to Rachel: 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional Model Configuration (defaults to eleven_multilingual_v2)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
